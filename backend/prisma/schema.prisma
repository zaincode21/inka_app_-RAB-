generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  FARM_OWNER
  FARM_MANAGER
  VETERINARIAN
  WORKER
}

enum AnimalSex {
  MALE
  FEMALE
}

enum CattleStage {
  CALF
  WEANER
  HEIFER
  COW
  BULL
  STEER
}

enum CattleStatus {
  ACTIVE
  SOLD
  CULLED
  DEAD
  INACTIVE
}

enum ReproductiveStatus {
  OPEN
  BRED
  PREGNANT
  DRY
  LACTATING
  NOT_APPLICABLE
}

enum EventScope {
  INDIVIDUAL
  MASS
}

enum TransactionKind {
  INCOME
  EXPENSE
}

enum InventoryMovementKind {
  IN
  OUT
  ADJUST
}

model Farm {
  id              String   @id @default(cuid())
  name            String
  ownerName       String
  ownerPhone      String?
  location        String
  district        String   @default("")
  sector          String   @default("")
  currency        String   @default("RWF")
  weightUnit      String   @default("kg")
  milkUnit        String   @default("L")
  returnHeatDays  Int      @default(21)
  returnHeatTime  String   @default("08:00")
  milkPricePerLiter Decimal @default(0) @db.Decimal(12, 2)
  defaultMilkBuyer String?
  defaultMilkDestination String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users            User[]
  memberships      FarmMembership[]
  cattle           Cattle[]
  milkRecords      MilkRecord[]
  healthEvents     HealthEvent[]
  transactions     Transaction[]
  categories       Category[]
  auditLogs        AuditLog[]
  inventoryItems   InventoryItem[]
  inventoryMovements InventoryMovement[]
}

model FarmMembership {
  id        String   @id @default(cuid())
  userId    String
  farmId    String
  role      UserRole @default(FARM_OWNER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@unique([userId, farmId])
  @@index([farmId])
  @@index([userId])
}

model User {
  id           String   @id @default(cuid())
  farmId       String?
  firstName    String
  lastName     String
  email        String   @unique
  phone        String?
  passwordHash String?
  role         UserRole @default(FARM_OWNER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  farm         Farm?             @relation(fields: [farmId], references: [id], onDelete: SetNull)
  memberships  FarmMembership[]

  cattleCreated       Cattle[]      @relation("CattleCreatedBy")
  cattleUpdated       Cattle[]      @relation("CattleUpdatedBy")
  cattleDeleted       Cattle[]      @relation("CattleDeletedBy")
  eventsCreated       HealthEvent[] @relation("HealthEventCreatedBy")
  eventsUpdated       HealthEvent[] @relation("HealthEventUpdatedBy")
  eventsDeleted       HealthEvent[] @relation("HealthEventDeletedBy")
  milkRecordsCreated  MilkRecord[]  @relation("MilkRecordCreatedBy")
  milkRecordsUpdated  MilkRecord[]  @relation("MilkRecordUpdatedBy")
  milkRecordsDeleted  MilkRecord[]  @relation("MilkRecordDeletedBy")
  transactionsCreated Transaction[] @relation("TransactionCreatedBy")
  transactionsUpdated Transaction[] @relation("TransactionUpdatedBy")
  transactionsDeleted Transaction[] @relation("TransactionDeletedBy")
  inventoryMovementsCreated InventoryMovement[] @relation("InventoryMovementCreatedBy")
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]           @relation("AuditActor")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  farmId     String?
  actorId    String?
  action     String
  entityType String
  entityId   String?
  summary    String?
  metadata   Json?
  createdAt  DateTime @default(now())

  farm  Farm? @relation(fields: [farmId], references: [id], onDelete: SetNull)
  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([farmId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model Cattle {
  id                 String             @id @default(cuid())
  farmId             String?
  tagNumber          String             @unique
  name               String
  officialId         String?
  rfid               String?
  breed              String
  sex                AnimalSex
  stage              CattleStage
  status             CattleStatus       @default(ACTIVE)
  groupName          String?
  dateOfBirth        DateTime?
  entryDate          DateTime?
  weightKg           Decimal            @default(0) @db.Decimal(10, 2)
  bodyConditionScore Decimal            @default(0) @db.Decimal(3, 1)
  colorMarkings      String?
  source             String?
  sourceDetail       String?
  purchasePrice      Decimal            @default(0) @db.Decimal(12, 2)
  paddock            String?
  lactationNumber    Int                @default(0)
  parity             Int                @default(0)
  reproductiveStatus ReproductiveStatus @default(NOT_APPLICABLE)
  motherTag          String?
  fatherTag          String?
  notes              String?
  photoUri           String?
  createdByUserId    String?
  updatedByUserId    String?
  deletedAt          DateTime?
  deletedByUserId    String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  farm         Farm?         @relation(fields: [farmId], references: [id], onDelete: SetNull)
  createdBy    User?         @relation("CattleCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy    User?         @relation("CattleUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  deletedBy    User?         @relation("CattleDeletedBy", fields: [deletedByUserId], references: [id], onDelete: SetNull)
  healthEvents HealthEvent[]
  milkRecords  MilkRecord[]
  transactions Transaction[]
  attachments  Attachment[]

  @@index([farmId])
  @@index([tagNumber])
  @@index([stage, status])
  @@index([createdByUserId])
  @@index([deletedAt])
}

model HealthEvent {
  id                   String     @id @default(cuid())
  farmId               String?
  cattleId             String?
  scope                EventScope
  groupName            String?
  eventDate            DateTime
  eventType            String
  symptoms             String?
  diagnosis            String?
  medicine             String?
  dosage               String?
  route                String?
  frequency            String?
  withdrawalDays       Decimal    @default(0) @db.Decimal(6, 2)
  batchNumber          String?
  technician           String?
  vetName              String?
  vetContact           String?
  followUpDate         DateTime?
  weightKg             Decimal    @default(0) @db.Decimal(10, 2)
  bodyConditionScore   Decimal    @default(0) @db.Decimal(3, 1)
  semenUsed            String?
  bullResponsible      String?
  returnHeatDate       DateTime?
  breedingDate         DateTime?
  expectedDeliveryDate DateTime?
  calfTag              String?
  calfGender           AnimalSex?
  sourceEventId        String?
  notes                String?
  photoUri             String?
  createdByUserId      String?
  updatedByUserId      String?
  deletedAt            DateTime?
  deletedByUserId      String?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  farm         Farm?         @relation(fields: [farmId], references: [id], onDelete: SetNull)
  cattle       Cattle?       @relation(fields: [cattleId], references: [id], onDelete: SetNull)
  createdBy    User?         @relation("HealthEventCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy    User?         @relation("HealthEventUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  deletedBy    User?         @relation("HealthEventDeletedBy", fields: [deletedByUserId], references: [id], onDelete: SetNull)
  sourceEvent  HealthEvent?  @relation("EventCycle", fields: [sourceEventId], references: [id], onDelete: SetNull)
  derivedEvents HealthEvent[] @relation("EventCycle")
  transactions Transaction[]
  attachments  Attachment[]

  @@index([farmId])
  @@index([cattleId])
  @@index([eventDate])
  @@index([eventType])
  @@index([sourceEventId])
  @@index([createdByUserId])
  @@index([deletedAt])
}

model MilkRecord {
  id               String   @id @default(cuid())
  farmId           String?
  cattleId         String?
  date             DateTime
  milkType         String
  amTotal          Decimal  @default(0) @db.Decimal(10, 2)
  noonTotal        Decimal  @default(0) @db.Decimal(10, 2)
  pmTotal          Decimal  @default(0) @db.Decimal(10, 2)
  totalProduced    Decimal  @default(0) @db.Decimal(10, 2)
  totalUsed        Decimal  @default(0) @db.Decimal(10, 2)
  calfMilk         Decimal  @default(0) @db.Decimal(10, 2)
  rejectedMilk     Decimal  @default(0) @db.Decimal(10, 2)
  destination      String?
  buyer            String?
  pricePerLiter    Decimal  @default(0) @db.Decimal(12, 2)
  fatPercent       Decimal  @default(0) @db.Decimal(5, 2)
  proteinPercent   Decimal  @default(0) @db.Decimal(5, 2)
  somaticCellCount Decimal  @default(0) @db.Decimal(12, 2)
  notes            String?
  createdByUserId  String?
  updatedByUserId  String?
  deletedAt        DateTime?
  deletedByUserId  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  farm         Farm?         @relation(fields: [farmId], references: [id], onDelete: SetNull)
  cattle       Cattle?       @relation(fields: [cattleId], references: [id], onDelete: SetNull)
  createdBy    User?         @relation("MilkRecordCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy    User?         @relation("MilkRecordUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  deletedBy    User?         @relation("MilkRecordDeletedBy", fields: [deletedByUserId], references: [id], onDelete: SetNull)
  transactions Transaction[]
  attachments  Attachment[]

  @@index([farmId])
  @@index([cattleId])
  @@index([date])
  @@index([createdByUserId])
  @@index([deletedAt])
}

model Transaction {
  id               String          @id @default(cuid())
  farmId           String?
  cattleId         String?
  milkRecordId     String?
  healthEventId    String?
  kind             TransactionKind
  date             DateTime
  category         String
  title            String
  amount           Decimal         @default(0) @db.Decimal(12, 2)
  quantity         Decimal         @default(0) @db.Decimal(12, 2)
  unitPrice        Decimal         @default(0) @db.Decimal(12, 2)
  paymentMethod    String?
  buyerVendor      String?
  receiptNumber    String?
  taxAmount        Decimal         @default(0) @db.Decimal(12, 2)
  discountAmount   Decimal         @default(0) @db.Decimal(12, 2)
  notes            String?
  createdByUserId  String?
  updatedByUserId  String?
  deletedAt        DateTime?
  deletedByUserId  String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  farm        Farm?        @relation(fields: [farmId], references: [id], onDelete: SetNull)
  cattle      Cattle?      @relation(fields: [cattleId], references: [id], onDelete: SetNull)
  milkRecord  MilkRecord?  @relation(fields: [milkRecordId], references: [id], onDelete: SetNull)
  healthEvent HealthEvent? @relation(fields: [healthEventId], references: [id], onDelete: SetNull)
  createdBy   User?        @relation("TransactionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy   User?        @relation("TransactionUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  deletedBy   User?        @relation("TransactionDeletedBy", fields: [deletedByUserId], references: [id], onDelete: SetNull)
  attachments Attachment[]
  inventoryMovements InventoryMovement[]

  @@index([farmId])
  @@index([kind, date])
  @@index([category])
  @@index([createdByUserId])
  @@index([deletedAt])
}

model Category {
  id                     String   @id @default(cuid())
  farmId                 String?
  kind                   String
  name                   String
  isDefault              Boolean  @default(false)
  defaultWithdrawalDays  Decimal  @default(0) @db.Decimal(6, 2)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  farm Farm? @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@unique([farmId, kind, name])
  @@index([kind])
}

model Attachment {
  id            String   @id @default(cuid())
  ownerType     String
  uri           String
  label         String?
  cattleId      String?
  milkRecordId  String?
  healthEventId String?
  transactionId String?
  createdAt     DateTime @default(now())

  cattle      Cattle?      @relation(fields: [cattleId], references: [id], onDelete: Cascade)
  milkRecord  MilkRecord?  @relation(fields: [milkRecordId], references: [id], onDelete: Cascade)
  healthEvent HealthEvent? @relation(fields: [healthEventId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([ownerType])
}

model InventoryItem {
  id             String   @id @default(cuid())
  farmId         String?
  name           String
  category       String   @default("Feed")
  unit           String   @default("kg")
  quantityOnHand Decimal  @default(0) @db.Decimal(12, 2)
  reorderLevel   Decimal  @default(0) @db.Decimal(12, 2)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  farm       Farm?               @relation(fields: [farmId], references: [id], onDelete: Cascade)
  movements  InventoryMovement[]

  @@unique([farmId, name])
  @@index([farmId])
  @@index([category])
}

model InventoryMovement {
  id              String                @id @default(cuid())
  farmId          String?
  itemId          String
  kind            InventoryMovementKind
  quantity        Decimal               @db.Decimal(12, 2)
  unitCost        Decimal               @default(0) @db.Decimal(12, 2)
  totalCost       Decimal               @default(0) @db.Decimal(12, 2)
  date            DateTime
  notes           String?
  transactionId   String?
  createdByUserId String?
  createdAt       DateTime              @default(now())

  farm        Farm?         @relation(fields: [farmId], references: [id], onDelete: Cascade)
  item        InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  transaction Transaction?  @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  createdBy   User?         @relation("InventoryMovementCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([farmId])
  @@index([itemId, date])
  @@index([kind])
}
